# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
# Read by compose (${VAR}) and injected into the app container.
POSTGRES_USER=urlshortener
# Generate one per environment:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=urlshortener

# --- App -> Postgres ---
# "postgres" is the compose service name. Use the real host for RDS.
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=require

# --- App -> Redis ---
# "redis" is the compose service name. For ElastiCache use its primary
# endpoint and REDIS_TLS=true (required when in-transit encryption is on).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false
# ElastiCache AUTH token, if enabled. Blank for the compose Redis.
REDIS_PASSWORD=

# --- HTTP ---
# Port the Go process listens on, inside the container.
PORT=8080
# Host interface and port compose publishes the app on.
# Set HOST_BIND=127.0.0.1 when nginx/Caddy fronts the app on the same machine.
HOST_BIND=0.0.0.0
HOST_PORT=8080

# Public origin short links are built from. Must be what a browser sees:
#   local:  http://localhost:8080
#   EC2:    http://<public-ip>:8080   or   https://your.domain
BASE_URL=http://localhost:8080

# "dev" reloads HTML templates on each request. Compose forces "production".
APP_ENV=dev
